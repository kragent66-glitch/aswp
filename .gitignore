# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Experiments / data (never commit runs or datasets).
runs/
logs/
checkpoints/
# `data/*` rather than `data/` on purpose: an excluded directory is never descended into,
# so a negation inside it can never match. The manifest IS the record -- it carries the
# dataset revision, the raw and token-stream hashes and the tokenizer provenance that
# docs/06 item 5 requires to be committed before confirmatory training. The 939 MB token
# array it describes is not.
data/*
!data/train_manifest.json
*.pt
*.ckpt

# OS / editor
.DS_Store
.idea/
.vscode/

# Local scratch
*.tmp

# Benchmark artifacts: the frozen token stream is regenerated deterministically
# by bench/freeze_stream.py and verified against the sha256 recorded in its
# sidecar JSON, so the multi-megabyte array is not committed. Results and the
# sidecar metadata ARE committed -- they are the record.
bench/frozen/*.npy
bench/.cache/
